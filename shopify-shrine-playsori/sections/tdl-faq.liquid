{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tdl-scope color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="tdl-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tdl-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tdl-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="tdl-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Natives <details>/<summary>: Akkordeon ohne JavaScript {%- endcomment -%}
    <div class="tdl-faq">
      {%- for block in section.blocks -%}
        <details
          class="tdl-faq__item"
          {% if section.settings.open_first and forloop.first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="tdl-faq__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="tdl-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="tdl-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="tdl-section__footer">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--secondary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "TDL FAQ",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Häufige Fragen"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Erste Frage geöffnet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "FAQ-Strukturdaten ausgeben (SEO)",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button – Text",
      "default": "Kontakt aufnehmen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button – Link"
    },
    {"type": "select", "id": "color_scheme", "label": "Farbschema", "options": [{"value": "background-1", "label": "Weiss"}, {"value": "background-2", "label": "Zartrosa"}, {"value": "accent-1", "label": "Playsori-Pink"}, {"value": "accent-2", "label": "Rosa"}, {"value": "inverse", "label": "Dunkel"}], "default": "background-1"},
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Frage",
          "default": "Wie lange dauert der Versand?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwort",
          "default": "<p>Trage hier deine Versandzeiten ein.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TDL FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Wie lange dauert der Versand?" } },
        { "type": "question", "settings": { "question": "Kann ich Produkte zurückgeben?" } },
        { "type": "question", "settings": { "question": "Ab welchem Alter sind die Produkte geeignet?" } },
        { "type": "question", "settings": { "question": "Aus welchen Materialien bestehen die Produkte?" } }
      ]
    }
  ]
}
{% endschema %}
