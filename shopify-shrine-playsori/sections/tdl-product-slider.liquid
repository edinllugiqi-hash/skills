{%- comment -%}
  Produkt-Slider auf Basis von Dawns eigenem card-product-Snippet –
  Produktkarten sehen dadurch exakt wie im restlichen Shop aus.
  Wird auf der Startseite zweimal genutzt: Bestseller und Bundles.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign quick_add_enabled = false
  if section.settings.quick_add == 'standard'
    assign quick_add_enabled = true
  endif
-%}

{%- if quick_add_enabled -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .tdl-scroller {
    --tdl-desktop-cols: {{ section.settings.columns_desktop }};
    --tdl-mobile-col: {{ section.settings.mobile_card_width }}%;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_display = section.settings.products_to_show
  if collection != blank and collection.products_count < products_to_display
    assign products_to_display = collection.products_count
  endif
-%}

<div class="tdl-products tdl-scope color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="tdl-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tdl-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tdl-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="tdl-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="tdl-scroller{% if section.settings.desktop_layout == 'grid' %} tdl-scroller--grid{% endif %}"
      role="list"
      aria-label="{{ section.settings.heading | default: collection.title | escape }}"
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: products_to_display -%}
          <li class="grid__item">
            {%- render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_quick_add: quick_add_enabled,
              quick_add: section.settings.quick_add,
              section_id: section.id
            -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="grid__item">
            {%- render 'card-product', show_vendor: section.settings.show_vendor -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and collection != blank and collection.products_count > products_to_display -%}
      <div class="tdl-section__footer">
        <a href="{{ collection.url }}" class="button button--secondary">
          {{- section.settings.view_all_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TDL Produkt-Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "Am beliebtesten"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unsere Bestseller"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Max. Anzahl Produkte",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "„Alle ansehen“-Button anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Text „Alle ansehen“",
      "default": "Alle ansehen"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Layout Desktop",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Raster" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Sichtbare Spalten Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Kartenbreite Mobile",
      "default": 65
    },
    {
      "type": "header",
      "content": "Produktkarte"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "adapt", "label": "An Bild anpassen" },
        { "value": "portrait", "label": "Hochformat" },
        { "value": "square", "label": "Quadrat" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Bildform",
      "options": [
        { "value": "default", "label": "Standard" },
        { "value": "arch", "label": "Bogen" },
        { "value": "blob", "label": "Blob" },
        { "value": "chevronleft", "label": "Chevron links" },
        { "value": "chevronright", "label": "Chevron rechts" },
        { "value": "diamond", "label": "Raute" },
        { "value": "parallelogram", "label": "Parallelogramm" },
        { "value": "round", "label": "Rund" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Zweites Bild beim Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Hersteller anzeigen",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Produktbewertung anzeigen",
      "info": "Benötigt eine Bewertungs-App, die Produkt-Metafelder (reviews.rating) befüllt.",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Schnell hinzufügen",
      "options": [
        { "value": "none", "label": "Aus" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "standard"
    },
    {"type": "select", "id": "color_scheme", "label": "Farbschema", "options": [{"value": "background-1", "label": "Weiss"}, {"value": "background-2", "label": "Zartrosa"}, {"value": "accent-1", "label": "Playsori-Pink"}, {"value": "accent-2", "label": "Rosa"}, {"value": "inverse", "label": "Dunkel"}], "default": "background-1"},
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "TDL Produkt-Slider"
    }
  ]
}
{% endschema %}
