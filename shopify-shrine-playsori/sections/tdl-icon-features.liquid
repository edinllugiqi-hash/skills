{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .tdl-features__grid {
    --tdl-features-mobile: {{ section.settings.columns_mobile }};
    --tdl-features-desktop: {{ section.settings.columns_desktop }};
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tdl-scope color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="tdl-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tdl-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tdl-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="tdl-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="tdl-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="tdl-feature" {{ block.shopify_attributes }}>
          {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
            <span class="tdl-feature__icon">
              {%- if block.settings.custom_icon != blank -%}
                {{ block.settings.custom_icon | image_url: width: 112 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- render 'tdl-icon', icon: block.settings.icon -%}
              {%- endif -%}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="tdl-feature__title h4">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="tdl-feature__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "TDL Vorteile",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Warum Eltern uns vertrauen"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Spalten Mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Spalten Desktop",
      "default": 4
    },
    {"type": "select", "id": "color_scheme", "label": "Farbschema", "options": [{"value": "background-1", "label": "Weiss"}, {"value": "background-2", "label": "Zartrosa"}, {"value": "accent-1", "label": "Playsori-Pink"}, {"value": "accent-2", "label": "Rosa"}, {"value": "inverse", "label": "Dunkel"}], "default": "background-2"},
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "Keines" },
            { "value": "check", "label": "Haken" },
            { "value": "check-circle", "label": "Haken im Kreis" },
            { "value": "shield", "label": "Schild" },
            { "value": "leaf", "label": "Blatt" },
            { "value": "truck", "label": "Lieferwagen" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "heart", "label": "Herz" },
            { "value": "baby", "label": "Baby" },
            { "value": "puzzle", "label": "Puzzle" },
            { "value": "lock", "label": "Schloss" },
            { "value": "gift", "label": "Geschenk" },
            { "value": "chat", "label": "Sprechblase" },
            { "value": "star", "label": "Stern" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Eigenes Icon",
          "info": "Ersetzt das Icon oben."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Sicher & geprüft"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Schadstofffreie Materialien für jede Entwicklungsphase.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TDL Vorteile",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shield", "title": "Sicher & geprüft", "text": "<p>Schadstofffreie Materialien.</p>" } },
        { "type": "feature", "settings": { "icon": "puzzle", "title": "Montessori-inspiriert", "text": "<p>Fördert Motorik und Sinne.</p>" } },
        { "type": "feature", "settings": { "icon": "return", "title": "30 Tage Rückgabe", "text": "<p>Risikolos ausprobieren.</p>" } },
        { "type": "feature", "settings": { "icon": "chat", "title": "Persönlicher Support", "text": "<p>Wir helfen dir gerne weiter.</p>" } }
      ]
    }
  ]
}
{% endschema %}
