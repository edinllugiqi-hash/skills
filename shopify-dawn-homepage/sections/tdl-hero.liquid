{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.desktop_alignment
    when 'center'
      assign align = 'center'
      assign justify = 'center'
    when 'right'
      assign align = 'right'
      assign justify = 'flex-end'
    else
      assign align = 'left'
      assign justify = 'flex-start'
  endcase

  if section.settings.mobile_alignment == 'left'
    assign justify_mobile = 'flex-start'
  else
    assign justify_mobile = 'center'
  endif

  assign mobile_image = section.settings.image_mobile | default: section.settings.image
-%}

{%- style -%}
  #Hero-{{ section.id }} {
    --tdl-hero-height: {{ section.settings.desktop_height }}rem;
    --tdl-hero-ratio-mobile: {{ section.settings.mobile_ratio }};
    --tdl-hero-align: {{ align }};
    --tdl-hero-justify: {{ justify }};
    --tdl-hero-items: {{ justify }};
    --tdl-hero-align-mobile: {{ section.settings.mobile_alignment }};
    --tdl-hero-justify-mobile: {{ justify_mobile }};
    --tdl-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<section
  id="Hero-{{ section.id }}"
  class="tdl-hero color-{{ section.settings.color_scheme }} gradient{% if section.settings.mobile_overlay %} tdl-hero--overlay-mobile{% endif %}"
>
  <div class="tdl-hero__media">
    {%- if mobile_image != blank -%}
      {%- comment -%} <picture>: Mobile lädt nur das Mobile-Bild (LCP-optimiert) {%- endcomment -%}
      <picture>
        {%- if section.settings.image != blank -%}
          {%- assign desktop_image = section.settings.image -%}
          <source
            media="(min-width: 750px)"
            sizes="100vw"
            srcset="
              {%- if desktop_image.width >= 1100 -%}{{ desktop_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {%- if desktop_image.width >= 1500 -%}{{ desktop_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {%- if desktop_image.width >= 2000 -%}{{ desktop_image | image_url: width: 2000 }} 2000w,{%- endif -%}
              {%- if desktop_image.width >= 3000 -%}{{ desktop_image | image_url: width: 3000 }} 3000w,{%- endif -%}
              {{ desktop_image | image_url }} {{ desktop_image.width }}w
            "
          >
        {%- endif -%}
        {{
          mobile_image
          | image_url: width: 1100
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 550, 750, 1100',
            alt: mobile_image.alt
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="tdl-hero__content">
    <div class="tdl-hero__inner">
      {%- if section.settings.rating_text != blank -%}
        <div class="tdl-hero__rating">
          <span class="tdl-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- render 'tdl-icon', icon: 'star' -%}
            {%- endfor -%}
          </span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="tdl-hero__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading | escape -}}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="tdl-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="tdl-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--primary"
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--secondary"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="tdl-hero__badges" role="list">
          {%- for block in section.blocks -%}
            <li class="tdl-hero__badge" {{ block.shopify_attributes }}>
              {%- render 'tdl-icon', icon: block.settings.icon -%}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TDL Hero",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Bilder"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild Desktop",
      "info": "Empfohlen: 2880 × 1200 px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Bild Mobile",
      "info": "Optional. Empfohlen: 1080 × 1350 px (4:5). Ohne Auswahl wird das Desktop-Bild verwendet."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Bild-Überlagerung",
      "default": 0
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Bewertungszeile",
      "default": "4,8/5 aus über 10.000 Bewertungen",
      "info": "Leer lassen zum Ausblenden."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Spielzeug, das mit deinem Kind mitwächst"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sichere Lern- und Pflegeprodukte für jede Entwicklungsphase.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 – Text",
      "default": "Jetzt entdecken"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 – Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 – Text"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 – Link"
    },
    {
      "type": "header",
      "content": "Layout Desktop"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "rem",
      "label": "Mindesthöhe",
      "default": 60
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Ausrichtung Inhalt",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout Mobile"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "1 / 1", "label": "Quadrat (1:1)" },
        { "value": "4 / 5", "label": "Hochformat (4:5)" },
        { "value": "3 / 4", "label": "Hochformat (3:4)" },
        { "value": "9 / 16", "label": "Vollbild (9:16)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Ausrichtung Inhalt",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_overlay",
      "label": "Text auf dem Bild anzeigen",
      "info": "Aus: Text erscheint unter dem Bild (empfohlen für Lesbarkeit).",
      "default": false
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust-Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "Keines" },
            { "value": "check", "label": "Haken" },
            { "value": "check-circle", "label": "Haken im Kreis" },
            { "value": "shield", "label": "Schild" },
            { "value": "leaf", "label": "Blatt" },
            { "value": "truck", "label": "Lieferwagen" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "heart", "label": "Herz" },
            { "value": "baby", "label": "Baby" },
            { "value": "puzzle", "label": "Puzzle" },
            { "value": "lock", "label": "Schloss" },
            { "value": "gift", "label": "Geschenk" },
            { "value": "chat", "label": "Sprechblase" },
            { "value": "star", "label": "Stern" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Kostenloser Versand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TDL Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "text": "Kostenloser Versand" } },
        { "type": "badge", "settings": { "icon": "return", "text": "30 Tage Rückgabe" } },
        { "type": "badge", "settings": { "icon": "shield", "text": "Geprüfte Sicherheit" } }
      ]
    }
  ]
}
{% endschema %}
