{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .tdl-scroller {
    --tdl-desktop-cols: {{ section.settings.columns_desktop }};
    --tdl-mobile-col: {{ section.settings.mobile_card_width }}%;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="tdl-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tdl-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="tdl-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.summary_text != blank -%}
        <div class="tdl-reviews__summary">
          <span class="tdl-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- render 'tdl-icon', icon: 'star' -%}
            {%- endfor -%}
          </span>
          <span>{{ section.settings.summary_text | escape }}</span>
        </div>
      {%- endif -%}
    </div>

    <ul class="tdl-scroller{% if section.settings.desktop_layout == 'grid' %} tdl-scroller--grid{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <figure class="tdl-review">
            {%- if block.settings.image != blank -%}
              <div class="tdl-review__media">
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
                    widths: '300, 450, 700',
                    alt: block.settings.image.alt
                }}
              </div>
            {%- endif -%}

            <span class="tdl-stars" role="img" aria-label="{{ block.settings.rating }} von 5 Sternen">
              {%- for i in (1..block.settings.rating) -%}
                {%- render 'tdl-icon', icon: 'star' -%}
              {%- endfor -%}
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="tdl-review__title h5">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            <blockquote class="tdl-review__text rte">
              {{ block.settings.text }}
            </blockquote>

            <figcaption>
              <span class="tdl-review__author">
                {{- block.settings.author | escape -}}
                {%- if block.settings.verified -%}
                  <span class="tdl-review__verified">
                    {%- render 'tdl-icon', icon: 'check-circle' -%}
                    {{ section.settings.verified_label | escape }}
                  </span>
                {%- endif -%}
              </span>
              {%- if block.settings.product != blank -%}
                <a class="tdl-review__product link" href="{{ block.settings.product.url }}">
                  {{- block.settings.product.title | escape -}}
                </a>
              {%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="tdl-section__footer">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--secondary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TDL Bewertungen",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Von Familien weltweit geliebt"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Bewertungs-Zusammenfassung",
      "default": "4,8/5 aus über 10.000 Bewertungen"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Text „Verifiziert“",
      "default": "Verifizierter Kauf"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Layout Desktop",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Raster" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Sichtbare Spalten Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 60,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Kartenbreite Mobile",
      "default": 85
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button – Text",
      "default": "Alle Bewertungen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button – Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Sterne",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Unser Lieblingsspielzeug"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bewertungstext",
          "default": "<p>Füge hier eine echte Kundenbewertung ein.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Kundenname"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verifizierter Kauf",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Kundenfoto"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Bewertetes Produkt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TDL Bewertungen",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
