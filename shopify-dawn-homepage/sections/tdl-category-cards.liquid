{{ 'tdl-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .tdl-scroller {
    --tdl-desktop-cols: {{ section.settings.columns_desktop }};
    --tdl-mobile-col: {{ section.settings.mobile_card_width }}%;
  }
  .section-{{ section.id }}-padding .tdl-cat-card__media {
    --tdl-cat-ratio: {{ section.settings.image_ratio }};
    --tdl-cat-radius: {% if section.settings.image_shape == 'circle' %}50%{% else %}{{ section.settings.corner_radius | divided_by: 10.0 }}rem{% endif %};
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="tdl-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tdl-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tdl-section__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="tdl-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="tdl-scroller tdl-scroller--grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          if card_image == blank and block.settings.collection != blank
            assign card_image = block.settings.collection.featured_image
          endif
          assign card_title = block.settings.title | default: block.settings.collection.title
          assign card_link = block.settings.link | default: block.settings.collection.url
        -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="tdl-cat-card"
            {% if card_link != blank %}
              href="{{ card_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <div class="tdl-cat-card__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 75vw',
                    widths: '300, 450, 600, 900',
                    alt: card_title
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="tdl-cat-card__label">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
            </div>
            {%- if card_title != blank -%}
              <h3 class="tdl-cat-card__title h4">{{ card_title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="tdl-cat-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="tdl-section__footer">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--secondary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TDL Kategorie-Kacheln",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Shoppe nach Alter"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Grösse Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h0", "label": "Gross" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Kacheln"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "1 / 1", "label": "Quadrat" },
        { "value": "4 / 5", "label": "Hochformat" },
        { "value": "3 / 2", "label": "Querformat" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Bildform",
      "options": [
        { "value": "rounded", "label": "Abgerundet" },
        { "value": "circle", "label": "Kreis" }
      ],
      "default": "rounded"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Eckenradius",
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Spalten Desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Kartenbreite Mobile",
      "info": "Unter 100 % zeigt die nächste Karte an – signalisiert Wischen.",
      "default": 70
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button – Text",
      "default": "Alle Produkte"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button – Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Kachel",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion",
          "info": "Liefert Bild, Titel und Link, falls unten nichts gesetzt ist."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "0–12 Monate"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Untertitel",
          "default": "Sinne entdecken"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Label",
          "info": "z. B. „Neu“ oder „Beliebt“"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TDL Kategorie-Kacheln",
      "blocks": [
        { "type": "card", "settings": { "title": "0–12 Monate", "subtitle": "Sinne entdecken" } },
        { "type": "card", "settings": { "title": "1–3 Jahre", "subtitle": "Greifen & sortieren" } },
        { "type": "card", "settings": { "title": "3+ Jahre", "subtitle": "Kreativ lernen" } }
      ]
    }
  ]
}
{% endschema %}
